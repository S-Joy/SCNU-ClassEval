.fa {
  font-family: "iconfont" !important;
  font-size: 16px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.icon-jiaolian1:before {
  content: "\e69d";
}

.icon-kecheng:before {
  content: "\e673";
}

.icon-profile:before {
  content: "\e600";
}
.userinfo {
  flex-direction: column;
  align-items: center;
  position: absolute;
  top: 350rpx;
  width: 80vw;
  height: 220rpx;
  border-radius: 30rpx;
  background: white;
  box-shadow: 6px 4px 16px 0px rgba(0,0,0,0.1); 
  left: 50%;
  margin-left: -40vw;
  display: flex;
  align-items: center;
  justify-content: center;
}
.listcontainer{
  width: 80vw;
  height: 200rpx;
  border-radius: 30rpx;
  background: white;
  box-shadow: 6px 4px 16px 0px rgba(0,0,0,0.1); 
  left: 50%;
  margin-left: -40vw;
  position: absolute;
  top: 700rpx;
}

.userinfo-avatar {
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.userinfo-nickname {
  color:#636e72;
  font-weight: bold;
}

.usermotto {
  margin-top: 200px;
}
.top{
  background-image: url(https://7363-scnuca-4gp9nq6bd1a6b150-1304921864.tcb.qcloud.la/mixkit-team-members-working-side-by-side-on-laptops-379-desktop-wallpaper.png?sign=0d82d7e1810701a8bc28c28a5f40c0bc&t=1613802478);
  height: 450rpx;
  background-size: contain;
}
.user_content {
  position: relative;
  margin-top: 150rpx;
  margin-bottom: 150rpx;
  padding-top: 20rpx;

}
.user_content .user_main {
  position: relative;
  width: 90%;
  left: 50%;
  transform: translateX(-50%);
  top: -40rpx;
 
}
.user_content .user_main .history_wrap {
  background-color: white;

  box-shadow: 6px 4px 16px 0px rgba(0,0,0,0.1); 
  border-radius: 30rpx;
  width: 80vw;
  margin: 50rpx auto;
  display: flex;
  
}

.user_content .user_main .history_wrap navigator {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}
.user_content .user_main .history_wrap navigator .history_num {
  color: black;
  
}
.user_content .user_main .history_wrap navigator .history_name {
  color: black;
 
}
.user_content .judge_wrap {
  background-color: white;
  margin-top: 30rpx;
  width: 80vw;
  margin: 0 auto;
  font-size: 20rpx;
}
.user_content .judge_wrap .judge_content .judge_name{
  font-size: 28rpx;
}

.user_content .judge_wrap .judge_content {
  display: flex;
  box-shadow: 6px 4px 16px 0px rgba(0, 0, 0, 0.1); 
  border-radius: 30rpx;
}
.user_content .judge_wrap .judge_content navigator {
  font-size: 30rpx;
  padding: 20rpx 0;
  flex: 1;
  text-align: center;
  
}
.user_content .judge_wrap .judge_content navigator .iconfont {
  color: black;
 
}
.user_content .app_info_wrap {
  background-color: #fff;
  margin-top: 30rpx;
  box-shadow: 6px 4px 16px 0px rgba(0,0,0,0.1); 
  border-radius: 30rpx;
  width: 80vw;
  margin: 30rpx auto;
}
.user_content .app_info_wrap .app_info_item {
  padding: 20rpx;
 
}
.user_content .app_info_wrap .app_info_contact .contact {
  margin-left: 20rpx;
  display: flex;
  font-size: 30rpx;
  padding: 0 0rpx;
  color: black;
  background-color: white;

}
.user_content .app_info_wrap .app_info_contact .contact::after {
  border: none;
}
