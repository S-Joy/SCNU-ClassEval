/* pages/courses/courses-compulsory/courses.wxss */
.topnav{
  height: 5vh;
  font-size: 45rpx;
  font-weight: bold;
  padding-left: 50rpx;
  line-height: 10vh;
  margin-bottom: 60rpx;
  color: #26648E;
}
/* 课程 */
.course_wrapper{
  /* display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden; */
  /* transition: 0.5s; */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  
}
.course_view {
  display: flex;
  flex-direction: column;
  width: 80vw;
  height: 23vh;
  border: black 1px solid;
  background-color: #fff;
  border-radius: 0.5rem;
  margin-bottom: 65rpx;
  overflow: hidden;
  transition: 0.5s;
}
.course_text {
  color: black;
  font-weight: 800;
  font-size: 40rpx;
  margin-left: 40rpx;
  margin-top: 30rpx;
}
.course_ltext {
  color: black;
  font-weight: bold;
  font-size: 30rpx;
  margin-left: 40rpx;
  margin-top: 30rpx;
}
.image_view {
  align-items: center;
  width: 100rpx;
  height: 100rpx;
  margin-top: 10rpx;
  margin-left: 27rpx;
}
.image_view image {
  width: 100%;
  height: 100%;
}
.searchbox{
  width: 80vw; 
  height: 90rpx;
  background-color:#f5f6fa; border-radius: 30px;
  margin:40rpx auto;
  
}

.search{
  width: 80vw; 
  line-height: 90rpx;
  padding-left: 30rpx;
  display: flex;justify-content: space-between;align-items:center;height:100%;
  
}
.zero-list{
  display: flex;
  justify-content: center;
  align-items:center;
  color: gray;

}
.search-input{
  width:80vw;
}