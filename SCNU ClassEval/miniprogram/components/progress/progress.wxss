.slice-button {
  box-shadow: 7px 7px 15px rgba(55, 84, 170, .15), 0px 0px 15px rgba(55, 84, 170, .3);
  width: 45rpx;
  height: 45rpx;
  position: absolute;
  border-radius: 50%;
  background: white;
  cursor: pointer;
  z-index: 30;

}
.icon{
  position: absolute;
  left:650rpx;
  font-size: 60rpx;
  transition:color 1s;
  width: 60rpx;
  height: 60rpx;
}
